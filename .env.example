# Supabase — lấy tại Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
# Chỉ dùng phía server, TUYỆT ĐỐI không để lộ ra client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key

# Cloudflare Workers AI — sinh ảnh nền bằng AI (tuỳ chọn)
# Lấy tại dash.cloudflare.com: Account ID ở sidebar, API token tạo ở My Profile > API Tokens
# Chỉ dùng phía server, không có NEXT_PUBLIC_ nên không lọt ra trình duyệt
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
